# ============================================================
#  Imperium IMS — Production Environment Variables Template
# ============================================================

# ── 1. Backend Application Settings ──────────────────────────
# Active Spring Profile (MUST be set to 'prod' for production)
SPRING_PROFILES_ACTIVE=prod

# The port the backend server runs on
SERVER_PORT=8080

# ── 2. Database (MySQL) ──────────────────────────────────────
# Production DB Connection string, username, and secure password
DB_URL=jdbc:mysql://localhost:3306/imperium_prod?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# ── 3. Security (JWT & Google OAuth) ─────────────────────────
# A highly secure, base64 encoded string (at least 256 bits)
JWT_SECRET=your_super_secret_base64_encoded_key_here

# Google OAuth Client ID for authenticating users
GOOGLE_CLIENT_ID=325150917267-vj89om93c4nng1f513mkh54qom42f0a8.apps.googleusercontent.com

# ── 4. CORS & Networking ─────────────────────────────────────
# Allowed origins for API requests (e.g., your frontend URL)
CORS_ORIGINS=https://vioraimperium.com

# ── 5. Email (SMTP Configuration) ────────────────────────────
# Currently set as placeholders (Gmail automation deferred)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ── 6. External Integrations (WhatsApp/Twilio) ───────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ── 7. Frontend Specific Settings (.env.production) ──────────
# These variables should be placed in `frontend/.env.production` before building
# VITE_API_URL=https://api.vioraimperium.com/api
# VITE_GOOGLE_CLIENT_ID=325150917267-vj89om93c4nng1f513mkh54qom42f0a8.apps.googleusercontent.com
